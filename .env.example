# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Chat model used for routing, tool calling and answers
OPENAI_MODEL=gpt-5.4-mini

# Embeddings: "huggingface" (free, local, default) or "openai" (tiny cost, no PyTorch needed)
EMBEDDING_PROVIDER=huggingface

# Business shown first in the chat app (each business has its own link: /?business=<id>)
DEFAULT_BUSINESS_ID=novacart

# Optional password for the Admin page. Leave empty for local demos.
ADMIN_PASSWORD=
